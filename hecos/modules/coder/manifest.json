{
    "id": "coder",
    "tag": "CODER",
    "name": "Coder",
    "version": "1.0.0",
    "type": "system_app",
    "category": "SYSTEM",
    "description": "Software Development, AI Coding & Workspace Runner Suite for Hecos. Provides multi-file code generation and refactoring via Aider Sidecar, AST & Tree-sitter Repository Map, Git version control checkpoints, automated Project Test Runner, Workspace process watchdog, and native Windows CLI bridge.",
    "icon": "fas fa-code",
    "lazy_load": false,
    "llm_callable": true,
    "is_class_based": true,
    "status": "ONLINE (Coder Suite Active)",
    "commands": {
        "repo_map": "Generates a compact multi-language AST map (files, classes, functions, line numbers) for a codebase.",
        "project_tree": "Generates a compact project folder tree (skipping .git, __pycache__, python_env, node_modules).",
        "search_code": "Searches text/code recursively inside a project or module directory.",
        "check_syntax": "Checks syntax of a Python (.py), JSON (.json), YAML (.yaml/.yml), JS/TS, CSS, or HTML file on disk.",
        "run_project_test": "Runs a real Python script, unittest, or pytest suite inside an authorized workspace/project.",
        "run_aider_task": "Delegates a multi-file refactor/generation task to isolated Aider CLI.",
        "git_status": "Inspects Git branch and modified/untracked files inside a project repository.",
        "git_diff": "Shows unified Git diff for the repository or a specific file.",
        "git_checkpoint": "Saves a non-destructive Git checkpoint snapshot without mutating HEAD.",
        "git_restore": "Restores a file or tree from HEAD or a saved Git checkpoint.",
        "start_app": "Starts a persistent workspace script, local web server, or desktop GUI app.",
        "probe_url": "Tests a local running web server URL and referenced static CSS/JS assets.",
        "get_app_logs": "Reads live status and log output of a managed workspace application.",
        "list_running_apps": "Lists all active and recent workspace runs, including orphaned OS processes.",
        "stop_app": "Stops a running workspace application by run_id, OS PID, project folder/name, or all.",
        "stop_project_processes": "Stops all managed and orphaned OS processes locking a workspace project.",
        "open_coding_cli": "Opens a native Windows coding CLI window for a workspace project (aider, shell, or trace)."
    },
    "tool_schema": [
        {
            "type": "function",
            "function": {
                "name": "CODER__repo_map",
                "description": "Generates a compact multi-language AST map (files, classes, functions, line numbers) for a codebase.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Project root directory (defaults to projects workspace)."
                        },
                        "max_files": {
                            "type": "integer",
                            "description": "Maximum files to inspect (default 60)."
                        },
                        "max_lines": {
                            "type": "integer",
                            "description": "Maximum output lines (default 160)."
                        }
                    },
                    "required": []
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "CODER__project_tree",
                "description": "Generates a compact project folder tree (skipping .git, __pycache__, python_env, node_modules).",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string",
                            "description": "Root directory to inspect."
                        },
                        "max_depth": {
                            "type": "integer",
                            "description": "Maximum folder depth (1 to 6, default 3)."
                        }
                    },
                    "required": []
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "CODER__search_code",
                "description": "Searches text/code recursively inside a project or module directory.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "Substring to find in files."
                        },
                        "path": {
                            "type": "string",
                            "description": "Root directory or file to search."
                        },
                        "file_glob": {
                            "type": "string",
                            "description": "Optional filename filter such as *.py or *.js."
                        }
                    },
                    "required": [
                        "query"
                    ]
                }
            }
        },
        {
            "type": "function",
            "function": {
                "name": "CODER__check_syntax",
